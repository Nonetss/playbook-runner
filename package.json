{
  "name": "playbook-runner",
  "version": "0.3.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.5",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "hono": "^4.13.11",
      "@orpc/server": "^1.15.4",
      "@orpc/openapi": "^1.15.4",
      "@orpc/zod": "^1.15.4",
      "better-auth": "1.6.22",
      "@better-auth/api-key": "1.6.22",
      "@orpc/client": "^1.15.4",
      "@orpc/tanstack-query": "^1.15.4",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "pg": "^8.23.0",
      "@types/pg": "^8.23.1",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "@better-auth/core": "1.6.22"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "docker compose -f compose.dev.yml up --build --watch",
    "dev:down": "docker compose -f compose.dev.yml down",
    "dev:local": "turbo watch dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "generate-grpc": "turbo generate-grpc",
    "format": "biome check --write --linter-enabled=false . && bun run --filter ansible format",
    "dev:frontend": "turbo watch -F frontend dev",
    "dev:backend": "turbo watch -F backend dev",
    "gateway": "docker compose -f apps/gateway/compose.yml up --build",
    "db:push": "turbo -F @playbook-runner/db db:push",
    "db:pull": "turbo -F @playbook-runner/db db:pull",
    "db:studio": "turbo -F @playbook-runner/db db:studio",
    "db:generate": "turbo -F @playbook-runner/db db:generate",
    "db:migrate": "turbo -F @playbook-runner/db db:migrate",
    "db:seed": "turbo -F backend db:seed",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "turbo test",
    "test:e2e": "turbo -F frontend test:e2e",
    "test:e2e:ui": "turbo -F frontend test:e2e:ui",
    "test:e2e:headed": "turbo -F frontend test:e2e:headed",
    "check": "biome check --write .",
    "tailwind:check": "cd apps/frontend && tailwint",
    "tailwind:fix": "cd apps/frontend && tailwint --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@playbook-runner/config": "workspace:*",
    "@types/bun": "catalog:",
    "tailwint": "^1.1.16",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@better-auth/core": "1.6.22",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
