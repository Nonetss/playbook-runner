{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate-grpc"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".astro/**"],
      "env": ["PUBLIC_SERVER_URL", "NODE_ENV", "SKIP_ENV_VALIDATION"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^generate-grpc"],
      "outputs": ["dist/**", "*.tsbuildinfo", ".astro/**"]
    },
    "ansible#check-types": {
      "dependsOn": ["generate-grpc"],
      "outputs": []
    },
    "@playbook-runner/env#check-types": {
      "outputs": []
    },
    "@playbook-runner/api#build": {
      "outputs": []
    },
    "@playbook-runner/auth#build": {
      "outputs": []
    },
    "@playbook-runner/db#build": {
      "outputs": []
    },
    "@playbook-runner/env#build": {
      "outputs": []
    },
    "@playbook-runner/grpc#build": {
      "outputs": []
    },
    "@playbook-runner/grpc#check-types": {
      "dependsOn": ["^check-types", "generate-grpc"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@playbook-runner/logger#build": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "^generate-grpc"],
      "cache": false,
      "persistent": true,
      "interruptible": false,
      "inputs": ["package.json", ".env*"]
    },
    "generate-grpc": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "../../proto/**/*.proto"],
      "outputs": []
    },
    "@playbook-runner/grpc#generate-grpc": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "../../proto/**/*.proto"],
      "outputs": ["src/gen/**"]
    },
    "ansible#generate-grpc": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "../../proto/**/*.proto"],
      "outputs": ["app/grpc/gen/**"]
    },
    "db:push": {
      "cache": false
    },
    "db:pull": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "ansible#test": {
      "dependsOn": ["generate-grpc"],
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "test:e2e:headed": {
      "cache": false
    }
  }
}
