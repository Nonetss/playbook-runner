{
  "name": "@playbook-runner/grpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "true",
    "check-types": "tsc -b",
    "generate-grpc": "mkdir -p src/gen && bun node_modules/.bin/buf generate ../../proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@grpc/grpc-js": "^1.14.5",
    "@playbook-runner/env": "workspace:*",
    "@playbook-runner/logger": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@playbook-runner/config": "workspace:*",
    "@types/bun": "catalog:",
    "ts-proto": "^2.12.4",
    "typescript": "catalog:"
  }
}
