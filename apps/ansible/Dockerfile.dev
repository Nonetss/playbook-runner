# Dev image for compose.dev.yml: runs `fastapi dev` (auto-reload) from source.
# Edits reach the container through `docker compose watch` (sync), so the repo
# is never bind-mounted and .venv stays the container's own.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Same pinned uv as the production Dockerfile
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /usr/local/bin/uv

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        openssh-client \
        git \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Mirror the monorepo layout so the ../../python/grpc-toolkit path dependency
# in pyproject.toml/uv.lock resolves inside the image
WORKDIR /app/apps/ansible

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=apps/ansible/uv.lock,target=uv.lock \
    --mount=type=bind,source=apps/ansible/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=python,target=/app/python \
    uv sync --frozen --no-install-project --no-install-package grpc-toolkit

COPY python /app/python
COPY proto /app/proto
COPY apps/ansible/ .

# Dev deps stay installed (fastapi dev, grpcio-tools for the stub codegen);
# app/grpc/gen is gitignored, and a proto edit rebuilds this image
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen && \
    mkdir -p app/grpc/gen && \
    uv run --no-sync python -m grpc_tools.protoc -I /app/proto \
    --python_out=app/grpc/gen --grpc_python_out=app/grpc/gen \
    --pyi_out=app/grpc/gen /app/proto/*.proto

ENV PATH="/app/apps/ansible/.venv/bin:$PATH"

EXPOSE 8000 50051

# Host network (compose.dev.yml): same addresses as native `uv run fastapi dev`
# (HTTP :8000, gRPC :50051). STATE_DIR keeps its dev default
# (/app/.data/ansible-runner), backed by a named volume in compose.dev.yml.
CMD ["fastapi", "dev", "app/main.py", "--port", "8000"]
