---
import ArrowRight from "@lucide/astro/icons/arrow-right"
import TriangleAlert from "@lucide/astro/icons/triangle-alert"
import InstallCommand from "@/components/InstallCommand.astro"
import { type Lang, t } from "@/i18n/ui"
import { localized } from "@/lib/url"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const dict = t(lang)
---

<section
  id="install"
  aria-labelledby="install-title"
  class="border-t border-hairline py-20 lg:py-28"
>
  <div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-7">
      <h2
        id="install-title"
        class="text-title font-semibold tracking-tight text-strong"
      >
        {dict.install.heading}
      </h2>
      <p class="mt-5 text-lede text-foreground">{dict.install.lede}</p>
      <div class="mt-7">
        <InstallCommand lang={lang} />
      </div>
      <p
        class="mt-5 flex gap-3 rounded-[10px] border border-border bg-card px-4 py-3.5 text-meta text-foreground"
      >
        <TriangleAlert
          class="mt-0.5 size-4 shrink-0 text-strong"
          stroke-width={1.75}
        />
        <span>{dict.install.warning}</span>
      </p>
      <p class="mt-8 text-body text-muted-foreground">
        {dict.install.manual}{" "}
        <a
          href={localized(lang, "docs/deploy/")}
          class="focus-ring group inline-flex items-center gap-1 rounded-sm font-medium text-strong"
        >
          {dict.install.manualLink}
          <ArrowRight
            class="size-4 text-primary transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5"
            stroke-width={1.75}
          />
        </a>
      </p>
    </div>

    <div class="min-w-0 lg:col-span-5">
      <h3 class="text-label-caps text-muted-foreground">
        {dict.install.stepsLabel}
      </h3>
      <ol class="mt-4">
        {dict.install.steps.map((step, index) => (
            <li class="grid grid-cols-[2rem_1fr] border-t border-hairline py-4 text-body text-foreground">
              <span class="font-mono text-meta text-muted-foreground tabular-nums">
                {index + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
      </ol>
    </div>
  </div>
</section>
