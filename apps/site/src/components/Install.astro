---
import TriangleAlert from "@lucide/astro/icons/triangle-alert"
import ArrowLink from "@/components/ArrowLink.astro"
import InstallCommand from "@/components/InstallCommand.astro"
import { type Lang, t } from "@/i18n/ui"
import { localized } from "@/lib/url"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const dict = t(lang)
---

<section id="install" aria-labelledby="install-title" class="section-block">
  <div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-7">
      <h2 id="install-title" class="section-title">
        {dict.install.heading}
      </h2>
      <p class="mt-5 text-lede text-foreground">{dict.install.lede}</p>
      <div class="mt-7">
        <InstallCommand lang={lang} />
      </div>
      <p
        class="card-box mt-5 flex gap-3 bg-card px-4 py-3.5 text-meta text-foreground"
      >
        <TriangleAlert
          class="mt-0.5 size-4 shrink-0 text-strong"
          stroke-width={1.75}
        />
        <span>{dict.install.warning}</span>
      </p>
      <p class="mt-8 text-body text-muted-foreground">
        {dict.install.manual}{" "}
        <ArrowLink href={localized(lang, "docs/deploy/")}>
          {dict.install.manualLink}
        </ArrowLink>
      </p>
    </div>

    <div class="min-w-0 lg:col-span-5">
      <h3 class="text-label-caps text-muted-foreground">
        {dict.install.stepsLabel}
      </h3>
      <ol class="mt-4">
        {dict.install.steps.map((step, index) => (
            <li class="grid grid-cols-[2rem_1fr] border-t border-hairline py-4 text-body text-foreground">
              <span class="font-mono text-meta text-muted-foreground tabular-nums">
                {index + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
      </ol>
    </div>
  </div>
</section>
