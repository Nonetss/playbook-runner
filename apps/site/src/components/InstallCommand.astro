---
import CopyButton from "@/components/CopyButton.astro"
import { INSTALL_COMMAND, type Lang, t } from "@/i18n/ui"

interface Props {
  lang: Lang
  label?: string
}

const { lang, label } = Astro.props
const dict = t(lang)
---

<figure
  class="overflow-hidden rounded-[10px] border border-terminal-border bg-terminal-bg"
  data-copy-scope
>
  {label && (
      <figcaption class="flex items-center gap-2 border-b border-terminal-border bg-terminal-surface px-4 py-2 text-label-caps text-terminal-muted">
        <span class="size-1.5 rounded-full bg-primary" aria-hidden="true" />
        {label}
      </figcaption>
    )}
  <div class="flex items-start gap-3 py-3.5 pr-2 pl-4">
    <pre
      class="min-w-0 flex-1 py-1 text-data break-all whitespace-pre-wrap text-terminal-fg"
    ><code><span class="text-primary select-none" aria-hidden="true">$ </span>{INSTALL_COMMAND}</code></pre>
    <CopyButton lang={lang} text={INSTALL_COMMAND} label={dict.copy.label} />
  </div>
</figure>

<script>
import { bindCopyButtons } from "@/lib/copy"

bindCopyButtons()
</script>
