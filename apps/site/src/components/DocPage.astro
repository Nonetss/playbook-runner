---
import { render } from "astro:content"
import ArrowLeft from "@lucide/astro/icons/arrow-left"
import ArrowRight from "@lucide/astro/icons/arrow-right"
import ChevronDown from "@lucide/astro/icons/chevron-down"
import CopyButton from "@/components/CopyButton.astro"
import { type Lang, t } from "@/i18n/ui"
import Base from "@/layouts/Base.astro"
import { type Doc, docPath } from "@/lib/docs"
import { localized, REPO_URL } from "@/lib/url"

interface Props {
  lang: Lang
  doc: Doc
  docs: Doc[]
}

const { lang, doc, docs } = Astro.props
const dict = t(lang)
const { Content, headings } = await render(doc)
const toc = headings.filter((heading) => heading.depth === 2)
const index = docs.findIndex((entry) => entry.id === doc.id)
const previous = index > 0 ? docs[index - 1] : undefined
const next = docs[index + 1]
const editUrl = `${REPO_URL}/edit/main/apps/site/${doc.filePath ?? ""}`
---

<Base lang={lang} title={doc.data.title} description={doc.data.description}>
  <div
    class="page-container grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-x-14 xl:grid-cols-[13rem_minmax(0,1fr)_12rem]"
  >
    <nav
      aria-label={dict.docs.pages}
      class="lg:sticky lg:top-(--header-height) lg:max-h-[calc(100dvh-var(--header-height))] lg:self-start lg:overflow-y-auto lg:py-12"
    >
      <details class="group border-b border-hairline py-3 lg:hidden">
        <summary
          class="focus-ring flex cursor-pointer list-none items-center justify-between rounded-sm text-meta font-medium text-strong [&::-webkit-details-marker]:hidden"
        >
          <span>
            <span class="text-muted-foreground">{dict.docs.title} /</span>
            {doc.data.title}
          </span>
          <ChevronDown
            class="size-4 text-muted-foreground transition-transform group-open:rotate-180"
            stroke-width={1.75}
          />
        </summary>
        <ul class="mt-3 space-y-0.5 pb-1">
          {docs.map((entry) => (
              <li>
                <a
                  href={localized(lang, docPath(entry))}
                  aria-current={entry.id === doc.id ? "page" : undefined}
                  class="side-link py-2"
                >
                  {entry.data.title}
                </a>
              </li>
            ))}
        </ul>
      </details>

      <div class="hidden lg:block">
        <p class="px-2.5 text-label-caps text-muted-foreground">
          {dict.docs.title}
        </p>
        <ul class="mt-3 space-y-0.5">
          {docs.map((entry) => (
              <li>
                <a
                  href={localized(lang, docPath(entry))}
                  aria-current={entry.id === doc.id ? "page" : undefined}
                  class="side-link py-1.5"
                >
                  {entry.data.title}
                </a>
              </li>
            ))}
        </ul>
      </div>
    </nav>

    <article class="min-w-0 py-10 lg:py-14">
      <header class="max-w-[72ch]">
        <h1 class="text-title font-semibold tracking-tight text-strong">
          {doc.data.title}
        </h1>
        <p class="mt-4 text-lede text-muted-foreground">
          {doc.data.description}
        </p>
      </header>

      <div class="prose mt-10">
        <Content />
      </div>
      <template data-copy-template>
        <CopyButton lang={lang} class="absolute top-2.5 right-2.5" />
      </template>

      <footer class="mt-16 max-w-[72ch] border-t border-hairline pt-8">
        <div class="grid gap-4 sm:grid-cols-2">
          {previous && (
              <a
                href={localized(lang, docPath(previous))}
                class="card-box pager-link"
              >
                <span class="flex items-center gap-1.5 text-label-caps text-muted-foreground">
                  <ArrowLeft class="size-3" stroke-width={2} />
                  {dict.docs.previous}
                </span>
                <span class="mt-1 block text-body font-medium text-strong">
                  {previous.data.title}
                </span>
              </a>
            )}
          {next && (
              <a
                href={localized(lang, docPath(next))}
                class="card-box pager-link text-right sm:col-start-2"
              >
                <span class="flex items-center justify-end gap-1.5 text-label-caps text-muted-foreground">
                  {dict.docs.next}
                  <ArrowRight class="size-3" stroke-width={2} />
                </span>
                <span class="mt-1 block text-body font-medium text-strong">
                  {next.data.title}
                </span>
              </a>
            )}
        </div>
        <a
          href={editUrl}
          class="link-muted mt-6 inline-block rounded-sm text-meta underline decoration-border underline-offset-4"
        >
          {dict.docs.edit}
        </a>
      </footer>
    </article>

    {toc.length > 1 && (
        <aside class="hidden xl:sticky xl:top-(--header-height) xl:block xl:self-start xl:py-14">
          <p class="text-label-caps text-muted-foreground">
            {dict.docs.onThisPage}
          </p>
          <ul class="mt-3 space-y-2 border-l border-hairline">
            {toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-toc={heading.slug}
                  class="link-muted -ml-px block border-l border-transparent pl-3 text-meta data-active:border-strong data-active:text-strong"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
  </div>
</Base>

<script>
import { bindCopyButtons } from "@/lib/copy"

// A copy button on every code block of the page.
const template = document.querySelector<HTMLTemplateElement>(
  "template[data-copy-template]"
)
if (template) {
  for (const pre of document.querySelectorAll(".prose pre")) {
    const block = document.createElement("div")
    block.className = "code-block"
    block.toggleAttribute("data-copy-scope", true)
    pre.replaceWith(block)
    block.append(pre, template.content.cloneNode(true))
  }
  bindCopyButtons()
}

// Highlight the section being read in the "On this page" list.
const links = document.querySelectorAll<HTMLElement>("[data-toc]")
if (links.length && "IntersectionObserver" in window) {
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        for (const link of links)
          link.toggleAttribute(
            "data-active",
            link.dataset.toc === entry.target.id
          )
      }
    },
    { rootMargin: "0px 0px -70% 0px" }
  )
  for (const link of links) {
    const target = link.dataset.toc && document.getElementById(link.dataset.toc)
    if (target) observer.observe(target)
  }
}
</script>
