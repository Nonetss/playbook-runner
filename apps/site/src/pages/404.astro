---
import ArrowLink from "@/components/ArrowLink.astro"
import Base from "@/layouts/Base.astro"
import { href } from "@/lib/url"
---

<Base lang="en" title="Page not found">
  <div
    class="page-container flex min-h-[calc(100dvh-var(--header-height)-8rem)] flex-col justify-center py-20"
  >
    <p class="font-mono text-meta text-muted-foreground">404</p>
    <h1 class="mt-3 text-title font-semibold tracking-tight text-strong">
      This page does not exist.
    </h1>
    <p class="mt-4 max-w-160 text-lede text-foreground" lang="es">
      Esta página no existe.
    </p>
    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-body">
      <ArrowLink href={href()}>Home</ArrowLink>
      <a href={href("docs/")} class="link-muted rounded-sm">Docs</a>
    </div>
  </div>
</Base>
