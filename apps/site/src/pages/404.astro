---
import ArrowRight from "@lucide/astro/icons/arrow-right"
import Base from "@/layouts/Base.astro"
import { href } from "@/lib/url"
---

<Base lang="en" title="Page not found">
  <div
    class="mx-auto flex min-h-[calc(100dvh-var(--header-height)-8rem)] max-w-360 flex-col justify-center px-4 py-20 sm:px-6 lg:px-8"
  >
    <p class="font-mono text-meta text-muted-foreground">404</p>
    <h1 class="mt-3 text-title font-semibold tracking-tight text-strong">
      This page does not exist.
    </h1>
    <p class="mt-4 max-w-160 text-lede text-foreground" lang="es">
      Esta página no existe.
    </p>
    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-body">
      <a
        href={href()}
        class="focus-ring group inline-flex items-center gap-1.5 rounded-sm font-medium text-strong"
      >
        Home
        <ArrowRight class="size-4 text-primary" stroke-width={1.75} />
      </a>
      <a
        href={href("docs/")}
        class="focus-ring inline-flex items-center gap-1.5 rounded-sm text-muted-foreground hover:text-strong"
      >
        Docs
      </a>
    </div>
  </div>
</Base>
