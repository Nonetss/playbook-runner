---
import { fade } from "astro:transitions"
import { SectionSidebar } from "@/features/app-shell/components/section-sidebar"
import { SectionSidebarTrigger } from "@/features/app-shell/components/section-sidebar-trigger"
import Layout from "@/layouts/Layout.astro"

interface Props {
  title: string
  /**
   * Full-height page (editors, run consoles) on `split` viewports (`md` wide
   * and 34rem tall): the scroller stops scrolling and the page fills the
   * remaining height with `flex-1 min-h-0`. Otherwise (phones, landscape
   * phones) the page scrolls; editors and consoles keep a minimum height.
   */
  locked?: boolean
  /**
   * Caps the content to the remaining viewport height from `sm` up, for a
   * page that owns its own internal scroll region (e.g. a table with
   * `min-h-0 flex-1 overflow-y-auto`). Other pages keep page-level scroll.
   */
  boundedContent?: boolean
  /** `compact` tightens the page padding for dense tables. */
  padding?: "page" | "compact"
  /**
   * Persist the scroller offset across View Transitions (default). `false`
   * snaps to the top; `"owned"` skips restoration for a page whose own list
   * restores its position. Stamped on `<main>` and read by the persisted
   * sidebar island, never passed as a frozen island prop.
   */
  persistScroll?: boolean | "owned"
  /** Shows the floating "back to top" button once the page scrolls. */
  scrollToTop?: boolean
}

const {
  title,
  locked = false,
  boundedContent = false,
  padding = "page",
  persistScroll = true,
  scrollToTop = false,
} = Astro.props

// Mirrors what SidebarProvider writes on toggle, so the sidebar opens in the
// state the user left it instead of flashing open before collapsing.
const sidebarOpen = Astro.cookies.get("sidebar_state")?.value !== "false"
const currentPath = Astro.url.pathname
const paddingClass = {
  page: "px-4 py-6 sm:px-6",
  compact: "px-3 py-3 sm:px-6 sm:py-6",
}[padding]
---

<Layout title={title} frame="bare" locked>
  <div class="flex min-h-0 w-full min-w-0 flex-1">
    <div class="flex min-h-0 shrink-0" transition:persist="section-sidebar">
      <SectionSidebar
        client:only="react"
        currentPath={currentPath}
        defaultOpen={sidebarOpen}
      />
    </div>
    <main
      data-app-scroller=""
      data-scroll-to-top={scrollToTop ? "" : undefined}
      data-persist-scroll={persistScroll === "owned"
        ? "owned"
        : persistScroll
          ? undefined
          : "false"}
      class:list={[
        "flex min-h-0 min-w-0 flex-1 flex-col overflow-x-hidden overflow-anchor-none",
        // `locked` fixes the height on `split` viewports only: on phones the
        // stacked fields and the editor/console need page scroll.
        locked ? "overflow-y-auto split:overflow-hidden" : "overflow-y-auto",
      ]}
    >
      <div
        class="shrink-0 px-4 pt-2 md:hidden"
        transition:persist="section-trigger"
      >
        <SectionSidebarTrigger client:only="react" currentPath={currentPath} />
      </div>
      <div
        class:list={[
          "flex min-w-0 flex-1 flex-col [--page-max-width:100%]",
          paddingClass,
          locked && "split:min-h-0",
          boundedContent && "min-h-0",
          locked && "stacked:pt-2 split:overflow-hidden",
          boundedContent &&
            !locked &&
            "sm:overflow-hidden",
        ]}
        transition:animate={fade({ duration: "0.2s" })}
      >
        <slot />
      </div>
    </main>
  </div>
</Layout>
