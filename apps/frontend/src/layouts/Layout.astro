---
import "@/styles/global.css"
import { ClientRouter, fade } from "astro:transitions"
import { Toaster } from "@/components/ui/sonner"
import { NavbarAuthenticated } from "@/features/app-shell/components/navbar-authenticated"
import { NavbarGuest } from "@/features/app-shell/components/navbar-guest"

interface Props {
  title: string
  guestNavbar?: boolean
}

const { title, guestNavbar = false } = Astro.props

const { user, session, locale } = Astro.locals
const hasSession = !!user && !!session
---

<html lang={locale}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
    function applyTheme(doc) {
      const stored = localStorage.getItem("theme")
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches
      const theme = stored ?? (prefersDark ? "dark" : "light")
      doc.documentElement.classList.toggle("dark", theme === "dark")
    }
    applyTheme(document)
    document.addEventListener("astro:before-swap", (event) =>
      applyTheme(event.newDocument)
    )
    </script>
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
  </head>
  <body class="flex min-h-screen flex-col">
    {guestNavbar || !hasSession ? (
        <NavbarGuest client:only="react" transition:persist nameApp="Playbook Runner" locale={locale} />
      ) : (
        <NavbarAuthenticated
          client:only="react"
          transition:persist
          user={user}
          session={session}
          nameApp="Playbook Runner"
          currentPath={Astro.url.pathname}
          locale={locale}
        />
      )}
    <div
      class="flex min-h-0 flex-1 flex-col"
      transition:animate={fade({ duration: "0.2s" })}
    >
      <slot />
    </div>
    <Toaster client:only="react" />
  </body>
</html>
