---
import "@/styles/global.css"
import { ClientRouter, fade } from "astro:transitions"
import { ScrollToTopButton } from "@/components/shared/layout/scroll-to-top-button"
import { Toaster } from "@/components/ui/sonner"
import { NavbarAuthenticated } from "@/features/app-shell/components/navbar-authenticated"
import { NavbarGuest } from "@/features/app-shell/components/navbar-guest"
import FontPreload from "@/layouts/font-preload.astro"
import PwaHead from "@/layouts/pwa-head.astro"

interface Props {
  title: string
  guestNavbar?: boolean
  /**
   * `page` (default): the layout owns `<main>` and the single page padding.
   * `bare`: the slot renders its own frame (login, `WithSidebar`).
   */
  frame?: "page" | "bare"
  /** Viewport-height shell: the document never scrolls; a page region does. */
  locked?: boolean
  /** `compact` tightens the page padding for dense tables. */
  padding?: "page" | "compact"
  /** Shows the floating "back to top" button once the page scrolls. */
  scrollToTop?: boolean
}

const {
  title,
  guestNavbar = false,
  frame = "page",
  locked = false,
  padding = "page",
  scrollToTop = false,
} = Astro.props

const paddingClass = {
  page: "px-4 py-6 sm:px-6",
  compact: "px-3 py-3 sm:px-6 sm:py-6",
}[padding]

const { user, session, locale } = Astro.locals
const hasSession = !!user && !!session
---

<html lang={locale}>
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    >
    <title>{title}</title>
    <FontPreload />
    <ClientRouter />
    <script is:inline>
    function applyTheme(doc) {
      const stored = localStorage.getItem("theme")
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches
      const theme = stored ?? (prefersDark ? "dark" : "light")
      doc.documentElement.classList.toggle("dark", theme === "dark")
    }
    applyTheme(document)
    document.addEventListener("astro:before-swap", (event) =>
      applyTheme(event.newDocument)
    )
    </script>
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
    <PwaHead />
  </head>
  <body
    class:list={[
      "flex flex-col",
      locked ? "h-dvh overflow-hidden" : "min-h-dvh",
    ]}
    data-layout={locked ? "locked" : undefined}
  >
    {guestNavbar || !hasSession ? (
        <NavbarGuest
          client:only="react"
          transition:persist="navbar-guest"
          nameApp="Playbook Runner"
          locale={locale}
        />
      ) : (
        <NavbarAuthenticated
          client:only="react"
          transition:persist="navbar-auth"
          user={user}
          session={session}
          nameApp="Playbook Runner"
          currentPath={Astro.url.pathname}
          locale={locale}
        />
      )}
    {frame === "bare" ? (
        <div class="flex min-h-0 flex-1 flex-col">
          <slot />
        </div>
      ) : (
        <main
          class:list={[
            "flex min-h-0 min-w-0 flex-1 flex-col",
            paddingClass,
            locked && "overflow-hidden",
          ]}
          data-scroll-to-top={scrollToTop ? "" : undefined}
          transition:animate={fade({ duration: "0.2s" })}
        >
          <slot />
        </main>
      )}
    <Toaster client:only="react" />
    <div class="scroll-to-top-root" transition:persist="scroll-to-top">
      <ScrollToTopButton client:only="react" />
    </div>
  </body>
</html>
