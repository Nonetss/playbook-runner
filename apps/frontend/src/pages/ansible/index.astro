---
import { SectionNavOverview } from "@/features/app-shell/components/section-nav-overview"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { appSurfaces } from "@/lib/app-surfaces"
import { getServerT } from "@/lib/i18n/server"

const { locale } = Astro.locals
const t = await getServerT(locale, "nav")
---

<WithSidebar title={t(appSurfaces.ansible.titleKey)}>
  <SectionNavOverview client:only="react" section="ansible" />
</WithSidebar>
