---
import { RunScriptPage } from "@/features/scripts"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { id } = Astro.params
const { locale } = Astro.locals
const t = await getServerT(locale, "scripts")
---

<WithSidebar title={t("run.document_title")} locked>
  <RunScriptPage client:only="react" id={id} />
</WithSidebar>
