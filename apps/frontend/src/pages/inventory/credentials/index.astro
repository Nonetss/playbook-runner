---
import { CredentialsPage } from "@/features/credentials"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { locale } = Astro.locals
const t = await getServerT(locale, "credentials")
---

<WithSidebar title={t("page.title")} section="/inventory">
  <CredentialsPage client:only="react" />
</WithSidebar>
