---
import { PlaybookFormPage } from "@/features/playbooks/components/playbook-form-page"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { id } = Astro.params
const { locale } = Astro.locals
const t = await getServerT(locale, "playbooks")
---

<WithSidebar title={t("form.edit_title")} locked>
  <PlaybookFormPage client:only="react" id={id} />
</WithSidebar>
