---
import { RunPlaybookPage } from "@/features/playbooks/components/run-playbook-page"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { id } = Astro.params
const { locale } = Astro.locals
const t = await getServerT(locale, "playbooks")
---

<WithSidebar title={t("run.document_title")} locked>
  <RunPlaybookPage client:only="react" id={id} />
</WithSidebar>
