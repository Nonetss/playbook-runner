import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { locale } = Astro.locals
const t = await getServerT(locale, "nav")
---

<WithSidebar title={t("links.jobs")} section="/jobs">
