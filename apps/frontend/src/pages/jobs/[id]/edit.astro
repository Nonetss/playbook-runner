---
import { JobFormPage } from "@/features/jobs"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { id } = Astro.params
const { locale } = Astro.locals
const t = await getServerT(locale, "jobs")
---

<WithSidebar title={t("form.edit_title")}>
  <JobFormPage client:only="react" id={id} />
</WithSidebar>
