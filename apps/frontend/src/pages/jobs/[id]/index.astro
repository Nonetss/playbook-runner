---
import { JobDetailPage } from "@/features/jobs"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { getServerT } from "@/lib/i18n/server"

const { id } = Astro.params
const { locale } = Astro.locals
const t = await getServerT(locale, "jobs")
---

<WithSidebar title={t("detail.title")} locked>
  <JobDetailPage client:only="react" id={id} locale={locale} />
</WithSidebar>
